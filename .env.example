# Environment Configuration for Kampung Coin

# Private key for deployment (DO NOT commit actual private key!)
# PRIVATE_KEY=your_private_key_here

# Infura/Alchemy API keys for network deployment
# INFURA_API_KEY=your_infura_api_key
# ALCHEMY_API_KEY=your_alchemy_api_key

# Etherscan API key for contract verification
# ETHERSCAN_API_KEY=your_etherscan_api_key

# Network RPC URLs (optional, can use defaults)
# MAINNET_RPC_URL=https://mainnet.infura.io/v3/your_key
# GOERLI_RPC_URL=https://goerli.infura.io/v3/your_key
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_key

# Contract deployment parameters
INITIAL_SUPPLY=10000000
